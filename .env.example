# ==============================================================================
# MovieNite Frontend Environment Variables (GitHub Pages / Vite)
# ==============================================================================

# Backend API endpoint for Netlify Functions (Cloudflare R2 presigned upload/delete)
# Frontend URL: https://mizzy1638-sketch.github.io/MOVIENITEE15/ (GitHub Pages)
# Backend URL:  https://movienitee.netlify.app (Netlify Functions)
VITE_API_BASE_URL=https://movienitee.netlify.app

# Note: NETLIFY_AUTH_TOKEN is NOT required or used for GitHub Pages deployment.
# Server-side Cloudflare R2 credentials (CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_R2_ACCESS_KEY_ID,
# CLOUDFLARE_R2_SECRET_ACCESS_KEY, etc.) are configured directly in the Netlify
# Dashboard for the movienitee.netlify.app backend, NOT in the client frontend.
